# =============================================================
# Dawa Smart — Cloudflare Pages Redirects
# =============================================================
# Ensure single-page application routes work correctly
# All non-static paths fall back to the landing page (index.html)

# Redirect root to landing page
/  /index.html  200

# API routes to Cloudflare Worker
# Use staging Worker for development, production domain for live
# The app's JS also handles this fallback automatically
/api/*  https://dawa-smart-api.rashidjumachepkwony.workers.dev/:splat  200

# All other routes load the landing page
/*  /index.html  200

# Ensure app.html is accessible directly
/app.html  /app.html  200
