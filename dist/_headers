# Manifest
/manifest.json
  Content-Type: application/manifest+json; charset=utf-8

# Static assets — cache aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# API routes proxy to Cloudflare Worker
/api/*
  Content-Type: application/json