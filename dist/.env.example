# =============================================================
# Dawa Smart — Environment Configuration Template
# =============================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real .env file to Git.
# =============================================================

# ─── Supabase Configuration ───
# Get from: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJYourAnonymousKeyHere

# ─── Cloudflare Worker Secrets (NOT in .env — set via wrangler secret) ──
# DO NOT put these in .env.example — they must be set via:
#   wrangler secret put SUPABASE_SERVICE_ROLE
#   wrangler secret put JWT_SECRET
#
# The Service Role key should NEVER be in client-side code or .env files
# in the repository. It must only be set via the wrangler secret command.

# ─── Cloudflare Pages Configuration ───
# Deploy via the Cloudflare dashboard or Wrangler:
#   npx wrangler pages deploy .
#
# Add environment variable in Cloudflare Pages dashboard:
#   SUPABASE_URL = your Supabase project URL
#   SUPABASE_ANON_KEY = your Supabase anonymous key

# ─── Domain Configuration ───
# startechafrica.co.ke
# Configure DNS in Cloudflare dashboard:
#   - A record or CNAME for the root domain
#   - CNAME for www.startechafrica.co.ke
#   - Ensure nameservers are set at the registrar

# ── Optional: Analytics ──
# POSTHOG_API_KEY=
# PLAUSIBLE_DOMAIN=startechafrica.co.ke

# ── Optional: Email ──
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
